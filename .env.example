POSTGRES_USER=blinka
POSTGRES_PASSWORD=blinka
POSTGRES_DB=blinka
DATABASE_URL=postgresql+psycopg://blinka:blinka@localhost:5432/blinka

# Extracción de facturas con OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Opcional: modelos de respaldo si el principal falla (separados por coma)
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash-lite,anthropic/claude-haiku-5.5
# STORAGE_DIR=   (por defecto: backend/storage)
