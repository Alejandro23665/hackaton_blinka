POSTGRES_USER=blinka
POSTGRES_PASSWORD=blinka
POSTGRES_DB=blinka
DATABASE_URL=postgresql+psycopg://blinka:blinka@localhost:5432/blinka

# Lectura de documentos con Claude (API de Anthropic)
CLAUDE_KEY=
# AI_MODEL=claude-haiku-5-5
# Message Batches: mitad de precio, respuesta asíncrona (la mayoría en menos de una hora).
# false = una llamada por solicitud, más rápido para probar
# AI_BATCH=true
# Esfuerzo de razonamiento: low, medium, high, xhigh o max
# AI_EFFORT=medium

# Archivos originales e imágenes de páginas (en producción, un volumen persistente)
# STORAGE_DIR=/data/storage
# Diferencia permitida entre el total declarado y el calculado, en pesos
# TOTAL_TOLERANCE_CLP=0
# Segunda lectura de cada documento para descartar datos adivinados (duplica las llamadas a la IA)
# EXTRACTION_VERIFY=true

# Firma de las sesiones (inicio de sesión). Cualquier texto largo y secreto; sin ella, las sesiones
# se cierran al reiniciar el servidor
# SECRET_KEY=

# Administrador inicial: al arrancar (python -m app.usuarios admin-inicial) se crea este perfil si su
# email no existe. Después, su contraseña y su rol se administran desde la aplicación
# ADMIN_NOMBRE=Administrador
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
